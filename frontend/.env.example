# The prototype runs entirely on mock data and needs no environment variables.
#
# Only PUBLIC values belong here: they are shipped to the browser.
#
# Switch from the mock to the real backend (Phase 2E: cases, documents, safety check and run status are
# served; anything that needs the AI pipeline reports "not available" instead of showing fake data):
# NEXT_PUBLIC_API_MODE=http
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Real Google sign-in through Supabase Auth (default: the Phase 1 mock). Use together with API_MODE=http.
# ONLY the project URL and the PUBLIC anon key. A service-role key must never be placed here.
# NEXT_PUBLIC_AUTH_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Never put an AI provider key, a service-role key or any other secret in this file or in any
# NEXT_PUBLIC_* variable.
