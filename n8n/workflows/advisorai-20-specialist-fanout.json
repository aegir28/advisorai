{
  "id": "advisorai-specialist-fanout",
  "name": "AdvisorAI · 20 Specialist fan-out",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "run_id"
            }
          ]
        }
      },
      "id": "dbf54256-784c-5649-bbaf-95baf3581839",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "run_id",
              "value": "={{ $json.run_id }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "stage_id",
              "value": "specialist_fanout",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "fc1189e1-9784-5ea1-8ca6-76d79080bef7",
      "name": "Stage input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "advisorai-run-stage",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "a4c8c424-d0db-559d-bb07-5fbf26f28aae",
      "name": "Run fan-out stage",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "65f575f1-2ff1-5260-a829-701873229e7c",
      "name": "Stage ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const run_id = $('Stage input').first().json.run_id;\nreturn [{ json: { run_id, path: `/internal/orchestrator/v1/runs/${run_id}/plan`, body: '', timeout_ms: 180000 } }];\n"
      },
      "id": "6f5597d7-6438-5d4e-96be-0f855a2d81d1",
      "name": "Build plan call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "advisorai-signed-call",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "1c44515d-978c-5c9b-ae00-4d625df1d693",
      "name": "Plan",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1200,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst run_id = $('Stage input').first().json.run_id;\nif (!r.ok) return [];\nconst plan = r.result;\nconst crypto = require('crypto');\nconst secret = $env.ADVISORAI_N8N_HMAC_SECRET;\nconst base = String($env.ADVISORAI_API_BASE_URL || '').replace(/\\/$/, '');\nreturn plan.agents.map((a) => {\n  const path = `/internal/orchestrator/v1/runs/${run_id}/agents/${a.id}`;\n  const ts = String(Math.floor(Date.now() / 1000));\n  const hash = crypto.createHash('sha256').update('').digest('hex');\n  const sig = crypto.createHmac('sha256', secret).update(`${ts}.POST.${path}.${hash}`).digest('hex');\n  return { json: { agent_id: a.id, url: base + path, ts, sig, max_parallel: plan.max_parallel, timeout: Math.max(Number(a.timeout_s) * 1000, 10000) } };\n});\n"
      },
      "id": "63f8e2de-46b4-54ca-b346-d2cf7bd5b346",
      "name": "One item per specialist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Advisorai-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Advisorai-Signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": "={{ $json.timeout }}",
          "batching": {
            "batch": {
              "batchSize": "={{ $json.max_parallel }}",
              "batchInterval": 0
            }
          }
        }
      },
      "id": "4557426b-b503-576d-9025-f781d85d511d",
      "name": "Run specialists (parallel batches)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Every outcome is data. A failed or timed-out specialist is counted, never thrown: the backend already\n// stored it as 'unavailable' (or will, at collection, as 'not_run'); the run continues.\nconst items = $input.all().map((i) => i.json);\nconst bad = items.filter((j) => j.error || j.status !== 'ok').length;\nreturn [{ json: { status: 'ok', agents: items.length, unavailable: bad } }];\n"
      },
      "id": "3a8a7809-9a30-505c-9e43-507eea1d0da0",
      "name": "Fan in",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -120
      ]
    },
    {
      "parameters": {},
      "id": "0cc239b7-91f9-54c5-90f3-5540e6e8cca3",
      "name": "Fan-out failed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        120
      ]
    }
  ],
