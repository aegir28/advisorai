      "parameters": {
        "jsCode": "// begin failed: there is nothing to run. Report it as a failed stage so the run is finished honestly.\nreturn [{ json: { run_id: $json.run_id, stage: 'begin', status: 'failed', code: $json.code || 'begin_failed', retryable: false, counts: {}, flags: {} } }];\n"
