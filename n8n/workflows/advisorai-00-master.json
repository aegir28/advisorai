    {
      "parameters": {
        "jsCode": "const run_id = $('Verify signature').first().json.run_id;\nconst body = JSON.stringify({ schema_version: 'begin_request.v1', execution_id: String($execution.id) });\nreturn [{ json: { run_id, path: `/internal/orchestrator/v1/runs/${run_id}/begin`, body, timeout_ms: 30000 } }];\n"
      },
      "id": "268338ef-3bfc-5573-a4ef-e29e3e7792ea",
      "name": "Build begin call",
