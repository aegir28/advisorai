    {
      "parameters": {
        "jsCode": "// One item per stage the backend described (minus those a resumed run already finished).\nconst r = $input.first().json;\nconst run_id = $('Verify signature').first().json.run_id;\nif (!r.ok) return [{ json: { run_id, abort: true, code: r.code, id: 'begin', kind: 'single', flags: {} } }];\nconst done = new Set(r.result.completed_stages);\nreturn r.result.stages.filter((s) => !done.has(s.id)).map((s) => ({ json: { run_id, ...s, flags: r.result.flags } }));\n"
      },
      "id": "79aae417-3b2b-598e-8a29-d32f59f731cf",
      "name": "Stages still to run",
      "type": "n8n-nodes-base.code",
