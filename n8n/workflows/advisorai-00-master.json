      "parameters": {
        "jsCode": "const run_id = $('Verify signature').first().json.run_id;\nconst body = JSON.stringify({ schema_version: 'begin_request.v1', execution_id: String($execution.id) });\nreturn [{ json: { run_id, path: `/internal/orchestrator/v1/runs/${run_id}/begin`, body, timeout_ms: 30000, max_tries: 3, backoff_ms: 5000 } }];\n"
      },
