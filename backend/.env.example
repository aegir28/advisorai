# AdvisorAI backend configuration. Copy to .env for local use; .env is git-ignored.
# Secrets belong ONLY in this backend's environment, never in the frontend or any NEXT_PUBLIC_* variable.
# Keep the secret values below EMPTY in this file; set them in your own .env or the host's secret store.

# local | test | production
ADVISORAI_ENVIRONMENT=local
ADVISORAI_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API. A wildcard is rejected.
ADVISORAI_CORS_ORIGINS=http://localhost:3000

# Serve /api/v1/docs, /api/v1/redoc and /api/v1/openapi.json. Turn off in production.
ADVISORAI_DOCS_ENABLED=true

# Prototype guard: the only accepted value. Real patient data stays locked out (ADR 0004).
ADVISORAI_DATA_MODE=synthetic_only

# --- Phase 2B: Supabase (all optional locally; production requires every one of them) ---------------
# Direct Postgres as the fail-closed `app_backend` role (ADR 0005). Scheme must be postgresql+asyncpg://
# e.g. postgresql+asyncpg://app_backend:<password>@127.0.0.1:54322/postgres
ADVISORAI_DATABASE_URL=
# A SEPARATE login as the narrow `app_system` role (the system path, e.g. the audit log). It must differ from
# the URL above: the user path can never switch to it (ADR 0005).
# e.g. postgresql+asyncpg://app_system:<password>@127.0.0.1:54322/postgres
ADVISORAI_SYSTEM_DATABASE_URL=

# JWTs are verified against the project's JWKS (asymmetric keys only).
# Local: http://127.0.0.1:54321/auth/v1/.well-known/jwks.json  and issuer http://127.0.0.1:54321/auth/v1
ADVISORAI_SUPABASE_JWKS_URL=
ADVISORAI_SUPABASE_JWT_ISSUER=

# Storage API (signed URLs). The service-role key is backend-only and must never be logged.
ADVISORAI_SUPABASE_URL=
ADVISORAI_SUPABASE_SERVICE_ROLE_KEY=
ADVISORAI_STORAGE_BUCKET=case-documents
# Signed-URL lifetime in seconds. Capped at 300 (5 minutes).
ADVISORAI_SIGNED_URL_TTL_SECONDS=300

# Server-side secret (>= 32 characters) for the HMAC of client IPs in the audit log.
ADVISORAI_AUDIT_IP_HMAC_SECRET=
